# Public
NEXT_PUBLIC_APP_URL=https://manglo.example
NEXT_PUBLIC_CASHFREE_MODE=sandbox

# Supabase Auth (publishable values are safe for browser use; RLS still protects data)
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Public company details shown on trust, contact and policy pages
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=support@manglo.in
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_SUPPORT_HOURS=Monday-Saturday, 10:00 AM-7:00 PM IST
NEXT_PUBLIC_POLICY_EFFECTIVE_DATE=12 September 2026

# Supabase Postgres
# For a persistent Hostinger Node server, Supavisor session mode (port 5432) is preferred.
# Use the direct URL for Prisma migrations when IPv6/direct connectivity is available.
DATABASE_URL=postgresql://prisma.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://prisma:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# App security - server only
CRON_SECRET=replace-with-at-least-32-random-bytes

# Cashfree - server only
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2023-08-01
CASHFREE_MODE=sandbox

# Upstream SMM provider - server only
SMM_API_URL=https://cheapestsmmpanels.com/api/v2
SMM_API_KEY=
SMM_RATE_CURRENCY=INR

# Pricing is provider rate + ₹0.50 below ₹10/1K, otherwise + ₹1/1K.
