# Public
NEXT_PUBLIC_APP_URL=https://manglo.example
NEXT_PUBLIC_CASHFREE_MODE=sandbox

# Public company details shown on trust, contact and policy pages
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=support@manglo.in
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_SUPPORT_HOURS=Monday-Saturday, 10:00 AM-7:00 PM IST
NEXT_PUBLIC_POLICY_EFFECTIVE_DATE=11 September 2026

# Supabase Postgres (Project Settings → Database → Connection string)
# Use the pooled URL for the app and direct URL for Prisma migrations.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# App security
SESSION_PEPPER=replace-with-64-random-characters
CRON_SECRET=replace-with-another-long-random-secret

# Cashfree - server only
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2023-08-01
CASHFREE_MODE=sandbox

# Upstream SMM provider - server only
SMM_API_URL=https://cheapestsmmpanels.com/api/v2
SMM_API_KEY=
SMM_RATE_CURRENCY=INR

# Pricing is provider rate + ₹0.50 below ₹10/1K, otherwise + ₹1/1K.
