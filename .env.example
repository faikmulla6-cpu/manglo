# Public
NEXT_PUBLIC_APP_URL=https://manglo.shop
NEXT_PUBLIC_CASHFREE_MODE=production

# Supabase Auth (publishable values are safe for browser use; RLS still protects data)
NEXT_PUBLIC_SUPABASE_URL=https://cfuxcbqgqrpmfsydzplb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_GBRLwqzpkA3Y3C5NKbxFXw_UzWHZMBO

# Public company details shown on trust, contact and policy pages
NEXT_PUBLIC_LEGAL_NAME=MANGLO
NEXT_PUBLIC_SUPPORT_EMAIL=support@manglo.shop
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_SUPPORT_HOURS=Monday-Saturday, 10:00 AM-7:00 PM IST
NEXT_PUBLIC_POLICY_EFFECTIVE_DATE=12 September 2026

# Supabase Postgres
# Copy the actual connection strings from Supabase Dashboard -> Connect.
# For a persistent Hostinger Node server, prefer Supavisor session mode when available.
# Never commit real database passwords.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:5432/postgres
DIRECT_URL=postgresql://USER:PASSWORD@POOLER_HOST:5432/postgres

# App security - server only
CRON_SECRET=replace-with-at-least-32-random-bytes

# Cashfree production - server only. Never prefix these with NEXT_PUBLIC_.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_API_VERSION=2025-01-01
CASHFREE_MODE=production

# Upstream SMM provider - server only
SMM_API_URL=https://cheapestsmmpanels.com/api/v2
SMM_API_KEY=
SMM_RATE_CURRENCY=INR
# Reject suspiciously small supplier responses instead of damaging the catalog.
SMM_MIN_SYNC_SERVICES=2000
# Require most of the locked curated service IDs to still exist before any write sync.
SMM_MIN_CURATED_MATCH_RATIO=0.75
# New supplier IDs are reviewed before they are allowed into the curated customer catalog.
SMM_IMPORT_NEW_SERVICES=false
# Pricing is provider rate + ₹0.50 below ₹10/1K, otherwise + ₹1/1K.
