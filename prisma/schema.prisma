generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrderStatus {
  QUEUED
  PROCESSING
  COMPLETED
  PARTIAL
  CANCELED
  FAILED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum LedgerType {
  DEPOSIT
  ORDER_DEBIT
  ORDER_REFUND
  ADJUSTMENT
}

enum SupportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

model User {
  id String @id @default(cuid())
  email String @unique
  phone String? @unique
  name String
  passwordHash String
  walletPaise BigInt @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  payments Payment[]
  orders Order[]
  ledger WalletLedger[]
  favorites Favorite[]
  tickets SupportTicket[]
}

model Session {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@index([userId, expiresAt])
}

model Payment {
  id String @id @default(cuid())
  userId String
  cfOrderId String @unique
  cfPaymentId String? @unique
  amountPaise BigInt
  status PaymentStatus @default(CREATED)
  rawStatus String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId], references:[id])
  ledger WalletLedger[]
  @@index([userId, createdAt])
}

model Service {
  id String @id @default(cuid())
  provider String @default("primary")
  providerServiceId String
  platform String
  category String
  name String
  description String? @db.Text
  averageTime String?
  providerRatePaisePerThousand BigInt
  retailRatePaisePerThousand BigInt
  min Int
  max Int
  refill Boolean @default(false)
  cancel Boolean @default(false)
  active Boolean @default(true)
  score Int @default(80)
  lastSyncedAt DateTime @default(now())
  orders Order[]
  favorites Favorite[]
  @@unique([provider, providerServiceId])
  @@index([platform, category, active])
}

model Favorite {
  id String @id @default(cuid())
  userId String
  serviceId String
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  service Service @relation(fields:[serviceId], references:[id], onDelete:Cascade)
  @@unique([userId, serviceId])
  @@index([userId, createdAt])
}

model SupportTicket {
  id String @id @default(cuid())
  publicId String @unique
  userId String
  orderId String?
  category String
  subject String
  message String @db.Text
  status SupportStatus @default(OPEN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@index([userId, createdAt])
}

model Order {
  id String @id @default(cuid())
  publicId String @unique
  userId String
  serviceId String
  providerOrderId String?
  link String @db.Text
  quantity Int
  chargedPaise BigInt
  providerCostPaise BigInt?
  status OrderStatus @default(QUEUED)
  providerStatus String?
  startCount String?
  remains Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId], references:[id])
  service Service @relation(fields:[serviceId], references:[id])
  ledger WalletLedger[]
  @@index([userId, createdAt])
}

model WalletLedger {
  id String @id @default(cuid())
  userId String
  type LedgerType
  amountPaise BigInt
  balanceAfterPaise BigInt
  paymentId String?
  orderId String?
  idempotencyKey String @unique
  note String?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id])
  payment Payment? @relation(fields:[paymentId], references:[id])
  order Order? @relation(fields:[orderId], references:[id])
  @@index([userId, createdAt])
}
