generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrderStatus {
  QUEUED
  PROCESSING
  COMPLETED
  PARTIAL
  CANCELED
  FAILED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum LedgerType {
  DEPOSIT
  ORDER_DEBIT
  ORDER_REFUND
  ADJUSTMENT
}

enum SupportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum AgencyLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  CLOSED
}

enum WebsiteProjectStatus {
  DRAFT
  INFORMATION_RECEIVED
  DESIGN_DEVELOPMENT
  CLIENT_REVIEW
  FINAL_CHANGES
  READY_TO_LAUNCH
  LIVE
}

enum WebsiteProjectAssetKind {
  LOGO
  BUSINESS_PHOTO
  WORK_PHOTO
  DOCUMENT
}

model User {
  id String @id @db.Uuid
  email String @unique
  phone String? @unique
  name String
  walletPaise BigInt @default(0)
  analyticsLinkedAt DateTime?
  referralCode String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payments Payment[]
  orders Order[]
  orderDraft OrderDraft?
  ledger WalletLedger[]
  favorites Favorite[]
  tickets SupportTicket[]
  aiConversations AiConversation[]
  analyticsEvents AnalyticsEvent[]
  referralsSent Referral[] @relation("ReferralReferrer")
  referralReceived Referral? @relation("ReferralReferred")
  websiteProjects WebsiteProject[]
  websiteProjectTeamAccess WebsiteProjectTeamAccess?
}

model Payment {
  id String @id @default(cuid())
  userId String @db.Uuid
  cfOrderId String @unique
  cfPaymentId String? @unique
  amountPaise BigInt
  status PaymentStatus @default(CREATED)
  rawStatus String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id])
  ledger WalletLedger[]
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Service {
  id String @id @default(cuid())
  provider String @default("primary")
  providerServiceId String
  platform String
  category String
  name String
  description String? @db.Text
  averageTime String?
  providerRatePaisePerThousand BigInt
  retailRatePaisePerThousand BigInt
  min Int
  max Int
  refill Boolean @default(false)
  cancel Boolean @default(false)
  active Boolean @default(true)
  operatorDisabled Boolean @default(false)
  score Int @default(80)
  lastSyncedAt DateTime @default(now())
  orders Order[]
  orderDrafts OrderDraft[]
  favorites Favorite[]
  @@unique([provider, providerServiceId])
  @@index([platform, category, active])
  @@index([active, lastSyncedAt])
}

model Favorite {
  id String @id @default(cuid())
  userId String @db.Uuid
  serviceId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  @@unique([userId, serviceId])
  @@index([userId, createdAt])
  @@index([serviceId])
}

model SupportTicket {
  id String @id @default(cuid())
  publicId String @unique
  userId String @db.Uuid
  orderId String?
  category String
  subject String
  message String @db.Text
  status SupportStatus @default(OPEN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Order {
  id String @id @default(cuid())
  publicId String @unique
  userId String @db.Uuid
  serviceId String
  providerOrderId String?
  link String @db.Text
  quantity Int
  chargedPaise BigInt
  providerCostPaise BigInt?
  status OrderStatus @default(QUEUED)
  providerStatus String?
  startCount String?
  remains Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])
  ledger WalletLedger[]
  referralQualification Referral? @relation("ReferralQualification")
  @@index([userId, createdAt])
  @@index([serviceId])
  @@index([status, updatedAt])
  @@index([status, createdAt])
}

model OrderDraft {
  id String @id @default(cuid())
  userId String @unique @db.Uuid
  serviceId String
  quantity Int
  link String @db.Text
  recoveryOpenedAt DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
  @@index([serviceId])
}

model Referral {
  id String @id @default(cuid())
  code String
  referrerId String @db.Uuid
  referredUserId String @unique @db.Uuid
  qualifyingOrderId String? @unique
  referrerRewardPaise BigInt @default(0)
  qualifiedAt DateTime?
  rewardedAt DateTime?
  createdAt DateTime @default(now())
  referrer User @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser User @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: Cascade)
  qualifyingOrder Order? @relation("ReferralQualification", fields: [qualifyingOrderId], references: [id], onDelete: SetNull)
  @@index([referrerId, createdAt])
  @@index([rewardedAt])
}

model WalletLedger {
  id String @id @default(cuid())
  userId String @db.Uuid
  type LedgerType
  amountPaise BigInt
  balanceAfterPaise BigInt
  paymentId String?
  orderId String?
  idempotencyKey String @unique
  note String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])
  @@index([userId, createdAt])
  @@index([orderId])
  @@index([paymentId])
}

model AiConversation {
  id String @id @default(cuid())
  userId String @db.Uuid
  title String @default("New chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]
  @@index([userId, updatedAt])
}

model AiMessage {
  id String @id @default(cuid())
  conversationId String
  role String
  content String @db.Text
  metadata Json?
  createdAt DateTime @default(now())
  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}

model AdminAuditLog {
  id String @id @default(cuid())
  adminEmail String
  action String
  entityType String
  entityId String
  before Json?
  after Json?
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([entityType, entityId])
}

model AnalyticsEvent {
  id String @id @default(cuid())
  userId String? @db.Uuid
  anonymousId String?
  sessionId String?
  event String
  path String?
  source String?
  medium String?
  campaign String?
  content String?
  term String?
  referrerHost String?
  metadata Json?
  uniqueKey String? @unique
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([event, createdAt])
  @@index([userId, createdAt])
  @@index([anonymousId, createdAt])
  @@index([sessionId, createdAt])
  @@index([source, campaign, createdAt])
}

model MarketingSpendDaily {
  id String @id @default(cuid())
  source String
  campaign String
  date DateTime @db.Date
  spendPaise BigInt
  impressions BigInt @default(0)
  clicks BigInt @default(0)
  currency String @default("INR")
  externalCampaignId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([source, campaign, date])
  @@index([date])
  @@index([source, campaign, date])
}

model MetaAdsWindsorDaily {
  id String @id @default(uuid()) @db.Uuid
  date DateTime @db.Date
  accountId String @map("account_id")
  campaign String
  campaignId String @map("campaign_id")
  adId String @map("ad_id")
  adName String? @map("ad_name")
  spend Decimal @default(0) @db.Decimal(18, 4)
  impressions BigInt @default(0)
  clicks BigInt @default(0)
  currency String?
  urlTags String? @db.Text @map("url_tags")
  dataFetchedAt DateTime? @map("data_fetched_at")
  importedAt DateTime @default(now()) @map("imported_at")
  @@index([accountId, adId, date])
  @@index([date])
  @@index([campaignId, date])
  @@map("MetaAdsWindsorDaily")
}


model AgencyInquiry {
  id String @id @default(cuid())
  reference String @unique
  name String
  email String
  phone String?
  company String?
  website String?
  service String
  budget String?
  timeline String?
  projectType String?
  message String @db.Text
  status AgencyLeadStatus @default(NEW)
  source String @default("website")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email, createdAt])
}


model WebsiteProject {
  id String @id @default(cuid())
  publicId String @unique
  userId String @db.Uuid
  businessName String?
  contactPerson String?
  category String?
  description String? @db.Text
  phone String?
  whatsapp String?
  businessEmail String?
  existingWebsite String?
  instagram String?
  facebook String?
  socialLinks Json?
  address String? @db.Text
  city String?
  region String?
  country String?
  mapsUrl String?
  noCustomerFacingLocation Boolean @default(false)
  openingDays Json?
  openingTime String?
  closingTime String?
  services Json?
  pricingNotes String? @db.Text
  primaryCta String?
  about String? @db.Text
  mustInclude String? @db.Text
  mustAvoid String? @db.Text
  preferredColors String?
  preferredStyle String?
  inspirationSites Json?
  testimonials Json?
  googleBusinessProfile String?
  existingDomain String?
  domainProvider String?
  additionalInstructions String? @db.Text
  currentStep Int @default(1)
  status WebsiteProjectStatus @default(DRAFT)
  submittedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets WebsiteProjectAsset[]

  @@index([userId, createdAt])
  @@index([status, updatedAt])
}

model WebsiteProjectAsset {
  id String @id @default(cuid())
  projectId String
  kind WebsiteProjectAssetKind
  bucket String @default("website-project-assets")
  path String @unique
  originalName String
  mimeType String
  sizeBytes Int
  createdAt DateTime @default(now())

  project WebsiteProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, kind, createdAt])
}

model WebsiteProjectTeamAccess {
  id String @id @default(cuid())
  userId String @unique @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
