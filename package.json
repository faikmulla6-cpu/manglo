{
  "name": "manglo-seller-toolkit",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && vite build && npm run build --workspace=manglo-studio && node scripts/publish-studio.mjs",
    "build:static": "node scripts/build.mjs",
    "audit:site": "node scripts/site-audit.mjs",
    "audit:links": "node scripts/link-audit.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace=manglo-studio",
    "mail:setup": "node scripts/configure-demo-mail.mjs",
    "mail:test": "node scripts/test-demo-mail.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.69.0",
    "motion": "^14.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "workspaces": [
    "studio"
  ]
}
